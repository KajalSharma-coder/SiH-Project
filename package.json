{
  "name": "fairtrade-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "npm --prefix server run dev",
    "dev:ml": "python -m uvicorn app:app --host 0.0.0.0 --port 8001 --app-dir ml_service",
    "start:backend": "npm --prefix server start",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.8.0",
    "recharts": "^2.15.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.33.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
